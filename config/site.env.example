# Site configuration — copy to config/site.env and fill in.
# Used by scripts/render.sh and scripts/apply.sh (source this file).
# Do NOT commit config/site.env.

# --- Kubernetes / naming ---
NAMESPACE=idm
LIFECYCLE_NAME=idm-lifecycle
# Product-neutral prefix for Jobs, ConfigMaps, SA, Role (e.g. idm-lifecycle-00-prereqs)

# --- Public ingress ---
PUBLIC_HOST=idm.example.com
PUBLIC_BASE_URL=https://idm.example.com
INGRESS_IP=192.0.2.20

# --- Engine / Identity Vault (hybrid: Engine often outside the cluster) ---
ENGINE_HOST=idm-engine.example.com
ENGINE_IP=192.0.2.10
VAULT_ADMIN_DN="cn=admin,ou=sa,o=system"
UA_ADMIN_DN="cn=uaadmin,ou=sa,o=data"
UA_DRIVER_DN="cn=User Application Driver,cn=driverset1,o=system"
UA_DRIVER_CN="User Application Driver"
DRIVERSET_DN="cn=driverset1,o=system"
USER_CONTAINER=o=data
USER_ROOT_CONTAINER="ou=users,o=data"
GROUP_ROOT_CONTAINER="ou=groups,o=data"
ADMIN_CONTAINER="ou=sa,o=data"
LDAP_PORT=389
LDAPS_PORT=636

# --- Postgres ---
PG_HOST=192.0.2.10
PG_PORT=5432
UA_DB_NAME=idmuserappdb
WFE_DB_NAME=igaworkflowdb
UA_WFE_DATABASE_USER=idmadmin

# --- Shared PVC + UA Deployment (OpenText Helm shapes) ---
SHARED_PVC_NAME=idm-shared
UA_DEPLOYMENT_NAME=identityapplications
# Full image ref available in the cluster (local tag or registry)
IMAGE_UA=identityapplication:idm-4.10.2.0200-81
IMAGE_PULL_POLICY=IfNotPresent
SMOKE_IMAGE=curlimages/curl:8.5.0

# --- Secret names + keys (must already exist in NAMESPACE) ---
COMMON_PASSWORD_SECRET=idm-common-password
COMMON_PASSWORD_KEY=password
KEYSTORE_SECRET=identity-manager-key-store-pwd
KEYSTORE_SECRET_KEY=keystore-pwd

# --- Paths inside the Job container ---
SHARED_CONFIG=/config
# Jar path inside ConfigMap mount
LIFECYCLE_LIB=/lifecycle/lib/idm-lifecycle-lib.jar

# --- Optional SSO / app contexts ---
UA_APP_CTX=IDMProv
WFE_APP_CTX=workflow
# FormRenderer shared-PVC config dir (Job 03 rewrites ServiceRegistry + OSP* to PUBLIC_BASE_URL)
FORMRENDERER_CONFIG_DIR=/config/FormRenderer
LIQUIBASE_CONTEXTS="prov,newdb,updatedb"
RESET_ISM=1
