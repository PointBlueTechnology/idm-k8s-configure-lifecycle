# Site configuration — copy to config/site.env and fill in.
# Used by scripts/render.sh and scripts/apply.sh (source this file).
# Do NOT commit config/site.env.

# --- Kubernetes / naming ---
NAMESPACE=idm
LIFECYCLE_NAME=idm-lifecycle
# Product-neutral prefix for Jobs, ConfigMaps, SA, Role (e.g. idm-lifecycle-00-prereqs)

# --- Public ingress ---
PUBLIC_HOST=idm.example.com
PUBLIC_BASE_URL=https://idm.example.com
INGRESS_IP=192.0.2.20

# --- Engine / Identity Vault (hybrid: Engine often outside the cluster) ---
ENGINE_HOST=idm-engine.example.com
ENGINE_IP=192.0.2.10
VAULT_ADMIN_DN="cn=admin,ou=sa,o=system"
UA_ADMIN_DN="cn=uaadmin,ou=sa,o=data"
UA_DRIVER_DN="cn=User Application Driver,cn=driverset1,o=system"
UA_DRIVER_CN="User Application Driver"
DRIVERSET_DN="cn=driverset1,o=system"
USER_CONTAINER=o=data
USER_ROOT_CONTAINER="ou=users,o=data"
GROUP_ROOT_CONTAINER="ou=groups,o=data"
ADMIN_CONTAINER="ou=sa,o=data"
LDAP_PORT=389
LDAPS_PORT=636

# --- Postgres ---
PG_HOST=192.0.2.10
PG_PORT=5432
UA_DB_NAME=idmuserappdb
WFE_DB_NAME=igaworkflowdb
UA_WFE_DATABASE_USER=idmadmin

# --- Shared PVC + UA Deployment (OpenText Helm shapes) ---
SHARED_PVC_NAME=idm-shared
UA_DEPLOYMENT_NAME=identityapplications
# Full image ref available in the cluster (local tag or registry)
IMAGE_UA=identityapplication:idm-4.10.2.0200-81
IMAGE_PULL_POLICY=IfNotPresent
SMOKE_IMAGE=curlimages/curl:8.5.0

# --- Secret names + keys (must already exist in NAMESPACE) ---
COMMON_PASSWORD_SECRET=idm-common-password
COMMON_PASSWORD_KEY=password
KEYSTORE_SECRET=identity-manager-key-store-pwd
KEYSTORE_SECRET_KEY=keystore-pwd

# --- Paths inside the Job container ---
SHARED_CONFIG=/config
# Jar path inside ConfigMap mount
LIFECYCLE_LIB=/lifecycle/lib/idm-lifecycle-lib.jar

# --- Optional SSO / app contexts ---
UA_APP_CTX=IDMProv
WFE_APP_CTX=workflow
# FormRenderer shared-PVC config dir (Job 03 rewrites ServiceRegistry + OSP* to PUBLIC_BASE_URL)
FORMRENDERER_CONFIG_DIR=/config/FormRenderer
LIQUIBASE_CONTEXTS="prov,newdb,updatedb"
RESET_ISM=1

# --- eDirectory / Identity Vault backup (CronJob) ---
# Hot full backup via dsbk on the vault, copied to BACKUP_PVC_NAME.
# See docs/EDIR_BACKUP.md. Not part of --all (that path backs up ism + Postgres only).
#
# INCLUDE_NICI (site.yaml: includeNici) default true.
# true  = dsbk -e wraps NICI key material into the backup (required to open the DIB
#         on another host). The backup then contains vault data AND NICI keys.
# false = DIB (+ streams) only. Restore works only on a server that still has the
#         original NICI files. A lost container cannot be rebuilt from this backup.
INCLUDE_NICI=true
INCLUDE_STREAMS=true
INCLUDE_NDS_CONF=true
NICI_BACKUP_SECRET=idm-nici-backup
NICI_BACKUP_SECRET_KEY=password

# Cron is UTC. Example: 02:00 every day.
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_TIMEZONE=UTC
BACKUP_PVC_NAME=idm-vault-backup
BACKUP_DEST=/backups/edir
BACKUP_PREFIX=edir
BACKUP_RETENTION_COUNT=14
BACKUP_RETENTION_DAYS=0
BACKUP_ACTIVE_DEADLINE_SECONDS=7200
BACKUP_FS_GROUP=0
# Image must provide bash, openssh-client, base64, and kubectl. See images/edir-backup/Dockerfile.
IMAGE_VAULT_BACKUP=edir-backup:local

# Where the Identity Engine *container* runs. The same CronJob handles both:
#   standalone — container on a host outside the cluster. The job SSHes to
#                VAULT_SSH_HOST and docker execs into VAULT_DOCKER_CONTAINER.
#   k8s        — container is a pod in this cluster. The job kubectl-execs into
#                the pod selected below.
# Aliases: ssh-docker = standalone, incluster = k8s.
# ssh = eDirectory installed on the host itself, not in a container.
VAULT_TARGET=standalone
# --- standalone (engine container on a host) ---
VAULT_SSH_HOST=192.0.2.10
VAULT_SSH_PORT=22
VAULT_SSH_USER=backup
VAULT_SSH_SECRET=idm-vault-ssh
VAULT_SSH_SECRET_KEY=ssh-privatekey
VAULT_SSH_KNOWN_HOSTS_KEY=known_hosts
VAULT_SSH_STRICT_HOST_KEY=yes
VAULT_DOCKER_BIN=docker
VAULT_DOCKER_CONTAINER=engine-container
# Set true when the SSH user must `sudo -n docker` (not in the docker group).
VAULT_DOCKER_SUDO=false
# --- k8s (engine container is a pod). Ignored unless VAULT_TARGET=k8s. ---
# Finds the Running pod from a Deployment or StatefulSet selector.
# Example:
#   VAULT_TARGET=k8s
#   VAULT_WORKLOAD_KIND=deployment
#   VAULT_WORKLOAD_NAME=identityengine
#   VAULT_POD_CONTAINER=identityengine
VAULT_WORKLOAD_KIND=
VAULT_WORKLOAD_NAME=
VAULT_POD_NAME=
VAULT_POD_LABEL_SELECTOR=
VAULT_SERVICE_NAME=
VAULT_POD_NAMESPACE=idm
# Empty = the pod's only container. Required when the pod has more than one.
VAULT_POD_CONTAINER=
# Empty = container/SSH default user. dsbk -e (INCLUDE_NICI=true) must run as root, not nds.
VAULT_EXEC_USER=
# IDM engine container (see scripts/engine-fix-nds-interfaces.sh).
# eDirectory-only 25.4 container image: /config/eDirectory/inst/conf/nds.conf
VAULT_NDS_CONF=/etc/opt/novell/eDirectory/conf/nds.conf
VAULT_STAGING_DIR=/tmp/idm-edir-backup
VAULT_DSBK_BIN=dsbk
