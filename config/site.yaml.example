# Optional YAML mirror of site.env.example (documentation only).
# Prefer config/site.env for render.sh / apply.sh.
namespace: idm
lifecycleName: idm-lifecycle
publicHost: idm.example.com
publicBaseUrl: https://idm.example.com
ingressIp: 192.0.2.20
engineHost: idm-engine.example.com
engineIp: 192.0.2.10
pgHost: 192.0.2.10
pgPort: 5432
sharedPvcName: idm-shared
uaDeploymentName: identityapplications
imageUa: identityapplication:idm-4.10.2.0200-81
secrets:
  commonPassword:
    name: idm-common-password
    key: password
  keystore:
    name: identity-manager-key-store-pwd
    key: keystore-pwd
# Identity Vault backup. includeNici defaults to true (dsbk -e). See docs/EDIR_BACKUP.md.
backup:
  schedule: "0 2 * * *"
  timeZone: UTC
  pvcName: idm-vault-backup
  retentionCount: 14
  includeNici: true
  includeStreams: true
  target: ssh-docker
  sshHost: 192.0.2.10
  dockerContainer: engine-container
  ndsConf: /etc/opt/novell/eDirectory/conf/nds.conf
  secrets:
    niciBackup:
      name: idm-nici-backup
      key: password
    ssh:
      name: idm-vault-ssh
      key: ssh-privatekey
